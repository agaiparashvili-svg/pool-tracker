rules_version = '2';
// SAWYOBI — დამოუკიდებელი საწყობის ბაზა (მხოლოდ საწყობი).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/wh_users/$(request.auth.uid)).data.get('role', '');
    }
    function approved() { return signedIn() && role() in ['admin','orderer','receiver','techreceiver']; }
    function isAdmin() { return signedIn() && role() == 'admin'; }

    // მომხმარებლები: თითოეული ქმნის თავის ჩანაწერს (მხოლოდ pending, ან ადმინის ელ-ფოსტა);
    // როლს ცვლის მხოლოდ ადმინი — თავს ვერავინ დაინიშნავს ადმინად.
    match /wh_users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && (request.resource.data.role == 'pending'
            || (request.auth.token.email == 'a.gaiparashvili@gmail.com' && request.resource.data.role == 'admin'));
      allow update, delete: if isAdmin();
    }

    // საწყობის მონაცემები — მხოლოდ დადასტურებული მომხმარებლები
    match /wh_products/{id} { allow read, write: if approved(); }
    match /wh_orders/{id}   { allow read, write: if approved(); }
    match /wh_moves/{id}    { allow read, write: if approved(); }
  }
}
