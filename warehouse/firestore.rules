rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function udata() { return get(/databases/$(database)/documents/pool_users/$(request.auth.uid)).data; }
    function whRole() { return udata().get('whRole', ''); }
    function poolRole() { return udata().get('role', ''); }
    function approved() {
      return signedIn() && (whRole() in ['admin','orderer','receiver'] || poolRole() in ['admin','orderer','receiver']);
    }
    function isAdmin() {
      return signedIn() && (whRole() == 'admin' || poolRole() == 'admin');
    }

    match /pool_users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }
    match /pool_reports/{id} { allow read, write: if signedIn(); }
    match /wh_products/{id} { allow read, write: if approved(); }
    match /wh_orders/{id}   { allow read, write: if approved(); }
    match /wh_moves/{id}    { allow read, write: if approved(); }
  }
}
